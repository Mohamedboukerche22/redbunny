@include "std"
@include "algorithm"

main() {
    v = vector(2)
    v.push_back(10)
    v.push_back(20)
    v.push_front(5)

    writeln(v.get_size())      -- 3
    writeln(v.get(0))          -- 5
    writeln(v.get(1))          -- 10
    writeln(v.get(2))          -- 20
    writeln(v.get(3))          -- -1
    writeln(v.get_capacity())  -- 4

    empty = vector(0)
    writeln(empty.get_size())      -- 0
    writeln(empty.get(0))          -- -1
    writeln(empty.get_capacity())  -- 1
}
