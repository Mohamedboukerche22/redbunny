@include "std"
@include "mathlib"

main() {
    writeln(square(7))
    writeln(cube(3))
    writeln(power(2, 10))
    writeln(power(9, 0))
    writeln(power(2, -1))
    writeln(sqrt(4.0))
    writeln(sqrt(2.0))
    writeln(sin(0.0))
    writeln(cos(0.0))
    writeln(exp(0.0))
    writeln(exp(1.0))
    writeln(ln(euler()))
    writeln(ln(100.0))
    writeln(ln(0.5))
    writeln(PI())
    writeln(euler())
    writeln(tau())
    writeln(phi())
    writeln(max(3, 7))
    writeln(max(9, 2))
    writeln(max(-1, -5))
    writeln(max(4, 4))
    writeln(min(3, 7))
    writeln(min(9, 2))
    writeln(min(-1, -5))
    writeln(min(4, 4))
    writeln(maxf(3.5, 7.25))
    writeln(maxf(9.5, 2.0))
    writeln(maxf(-1.5, -5.5))
    writeln(maxf(4.0, 4.0))
    writeln(minf(3.5, 7.25))
    writeln(minf(9.5, 2.0))
    writeln(minf(-1.5, -5.5))
    writeln(minf(4.0, 4.0))
    writeln(abs(-5))
    writeln(abs(7))
    writeln(abs(0))
    writeln(gcd(48, 18))
    writeln(gcd(17, 5))
    writeln(gcd(-8, 12))
    writeln(lcm(4, 6))
    writeln(lcm(0, 5))
    writeln(lcm(-4, 6))
}
