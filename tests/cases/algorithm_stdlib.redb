@include "std"
@include "algorithm"

main() {
    writeln(MAX_INT64())
    writeln(MIN_INT64())

    array<int> a = {1, 3, 5, 7, 9}
    writeln(binary_search(a, 1))
    writeln(binary_search(a, 7))
    writeln(binary_search(a, 9))
    writeln(binary_search(a, 4))

    array<int> even = {1, 2, 3, 4}
    reverse(even)
    writeln(even[0])
    writeln(even[1])
    writeln(even[2])
    writeln(even[3])

    array<int> neg = {-8, -3, -20, -1}
    writeln(max_element(neg))
    writeln(min_element(neg))

    array<int> empty = {}
    writeln(max_element(empty))
    writeln(min_element(empty))

    array<int> s = {5, 1, 4, 2, 3}
    sort(s)
    writeln(s[0])
    writeln(s[1])
    writeln(s[2])
    writeln(s[3])
    writeln(s[4])

    array<int> d = {3, 1, 3, 2, 2}
    sort(d)
    writeln(d[0])
    writeln(d[1])
    writeln(d[2])
    writeln(d[3])
    writeln(d[4])

    array<int> one = {42}
    sort(one)
    writeln(one[0])

    array<int> zero = {}
    sort(zero)
    writeln(zero.size())
}
