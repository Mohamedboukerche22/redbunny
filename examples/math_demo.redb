-- RedBunny standard math library demo.
@include "std"
@include "mathlib"

main() {
    pi = PI()

    writeln(cos(pi))
    writeln(sin(pi))
    writeln(sqrt(5.0))
    writeln(power(2, 10))
    writeln(ln(euler()))
    writeln(max(3, 7))
    writeln(min(3, 7))
    writeln(maxf(3.5, 7.25))
    writeln(minf(3.5, 7.25))
}
