-- algorithm lib redbunny language
-- include it using @include "algorithm"

-- 64-bit signed integer limits. RedBunny has no const keyword, so these are
-- zero-argument constant helpers: call them as MAX_INT64() and MIN_INT64().
MAX_INT64 = do(-> int) {
    return 9223372036854775807
}

MIN_INT64 = do(-> int) {
    return -9223372036854775807 - 1
}

-- Binary search. The array must be sorted in ascending order.
-- Returns the index of the target, or -1 when it is not present.
binary_search = do(array<int>, int -> int) {
    l = 0
    r = arg1.size() - 1
    while (l <= r) {
        med = (l + r) / 2
        if (arg1[med] == arg2) {
            return med
        } else if (arg1[med] < arg2) {
            l = med + 1
        } else {
            r = med - 1
        }
    }
    return -1
}

-- Reverse an array in place.
-- 1 2 3 4 5 -> 5 4 3 2 1
reverse = do(array<int> -> array<int>) {
    l = 0
    r = arg1.size() - 1
    while (l < r) {
        tmp = arg1[r]
        arg1[r] = arg1[l]
        arg1[l] = tmp
        l = l + 1
        r = r - 1
    }
    return arg1
}
-- Largest element in an array. O(n) time.
-- Returns MIN_INT64() for an empty array.
max_element = do(array<int> -> int) {
    mx = MIN_INT64()
    for (i in 0 to arg1.size() - 1) {
        if (arg1[i] > mx) {
            mx = arg1[i]
        }
    }
    return mx
}

-- Smallest element in an array. O(n) time.
-- Returns MAX_INT64() for an empty array.
min_element = do(array<int> -> int) {
    mn = MAX_INT64()
    for (i in 0 to arg1.size() - 1) {
        if (arg1[i] < mn) {
            mn = arg1[i]
        }
    }
    return mn
}











-- In-place Heap Sort
-- O(n log n) time, O(1) extra space

sift_down = do(array<int>, int, int -> {}) {
    heap = arg1
    root = arg2
    heap_size = arg3

    while (true) {
        child = 2 * root + 1

        if (child >= heap_size) {
            break
        }
        if (child + 1 < heap_size && heap[child] < heap[child + 1]) {
            child = child + 1
        }
        if (heap[root] >= heap[child]) {
            break
        }
        temp = heap[root]
        heap[root] = heap[child]
        heap[child] = temp

        root = child
    }
}

sort = do(array<int> -> {}) {
    arr = arg1
    n = arr.size()

    start = n / 2 - 1

    while (start >= 0) {
        sift_down(arr, start, n)
        start = start - 1
    }
    finish = n - 1

    while (finish > 0) {
        temp = arr[0]
        arr[0] = arr[finish]
        arr[finish] = temp

        sift_down(arr, 0, finish)

        finish = finish - 1
    }
}









-- Allocate an int array from a runtime size. Useful for class fields.
new_int_array = do(int -> array<int>) {
    array<int> a(arg1)
    return a
}

-- FIFO queue with a fixed capacity ring buffer.
-- Create one with Queue(capacity); capacity must be greater than zero.
class Queue {
    array<int> data
    int head
    int tail
    int count
    int capacity

    init = do(int -> {}) {
        capacity = arg1
        data = new_int_array(capacity)
        head = 0
        tail = 0
        count = 0
    }

    enqueue = do(int -> {}) {
        if (count == capacity) {
            writeln("queue full")
            return
        }
        data[tail] = arg1
        tail = (tail + 1) % capacity
        count = count + 1
    }

    dequeue = do(-> int) {
        if (count == 0) {
            return -1
        }
        value = data[head]
        head = (head + 1) % capacity
        count = count - 1
        return value
    }

    front = do(-> int) {
        if (count == 0) {
            return -1
        }
        return data[head]
    }

    size = do(-> int) {
        return count
    }

    is_empty = do(-> bool) {
        return count == 0
    }

    is_full = do(-> bool) {
        return count == capacity
    }
}

-- Growable int vector with amortized O(1) push_back.
-- Create one with vector(initial_capacity); capacity is at least 1.
class vector {
    array<int> data
    int count
    int capacity

    init = do(int -> {}) {
        capacity = arg1
        if (capacity < 1) {
            capacity = 1
        }
        data = new_int_array(capacity)
        count = 0
    }

    reserve = do(int -> {}) {
        if (arg1 <= capacity) {
            return
        }
        while (capacity < arg1) {
            capacity = capacity * 2
        }
        data.resize(capacity)
    }

    push_back = do(int -> {}) {
        self.reserve(count + 1)
        data[count] = arg1
        count = count + 1
    }

    push_front = do(int -> {}) {
        self.reserve(count + 1)
        i = count
        while (i > 0) {
            data[i] = data[i - 1]
            i = i - 1
        }
        data[0] = arg1
        count = count + 1
    }

    get = do(int -> int) {
        if (arg1 < 0 || arg1 >= count) {
            return -1
        }
        return data[arg1]
    }

    get_size = do(-> int) {
        return count
    }

    get_capacity = do(-> int) {
        return capacity
    }
}
